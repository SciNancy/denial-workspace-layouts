+//! Per-workspace layout kind overrides with one layout instance per algorithm.
+//!
+//! Private fork patch: `layout.workspaceLayouts` in the settings document maps a
+//! workspace index to a layout kind; every other workspace follows the default
+//! `layout.windowLayout`. Each kind owns one `WindowLayout` instance whose trees
+//! stay keyed by the full `LayoutSpace`, so every workspace's tree survives
+//! regardless of which kind any other workspace uses.
+
+use std::collections::HashMap;
+use std::fmt::Debug;
+
+use smithay::utils::{Logical, Rectangle, Size};
+use tracing::warn;
+
+use super::window_layout::{
+    LayoutAxis, LayoutDirection, LayoutInsertion, LayoutPlacement, LayoutResizeRequest,
+    LayoutSpace, WindowLayout, WindowLayoutKind, create_window_layout,
+};
+
+type Instance<WindowId> = Box<dyn WindowLayout<WindowId>>;
+
+#[cfg(test)]
+mod tests {
+    use denial_core::topology::OutputId;
+    use smithay::utils::{Point, Rectangle, Size};
+
+    use super::*;
+    use crate::window_layout::LayoutDirection;
+
+    fn space(workspace: u8) -> LayoutSpace {
+        LayoutSpace::new(OutputId(1), workspace)
+    }
+
+    fn area() -> Rectangle<i32, Logical> {
+        Rectangle::new(Point::from((0, 0)), Size::from((1000, 600)))
+    }
+
+    fn prepare(registry: &mut LayoutRegistry<u64>, workspace: u8) {
+        registry.prepare_arrange(space(workspace), area(), 0, LayoutAxis::Horizontal);
+    }
+
+    #[test]
+    fn registry_routes_workspaces_to_overridden_kinds() {
+        let mut registry = LayoutRegistry::<u64>::new(WindowLayoutKind::Scrolling);
+        registry.set_kinds(
+            WindowLayoutKind::Scrolling,
+            HashMap::from([(2, WindowLayoutKind::Dwindle)]),
+        );
+        registry.insert(LayoutInsertion {
+            window: 1,
+            space: space(1),
+            anchor: None,
+        });
+        registry.insert(LayoutInsertion {
+            window: 2,
+            space: space(1),
+            anchor: Some(1),
+        });
+        registry.insert(LayoutInsertion {
+            window: 3,
+            space: space(2),
+            anchor: None,
+        });
+        registry.insert(LayoutInsertion {
+            window: 4,
+            space: space(2),
+            anchor: Some(3),
+        });
+        assert_eq!(
+            registry.kind_for_space(space(1)),
+            WindowLayoutKind::Scrolling
+        );
+        assert_eq!(registry.kind_for_space(space(2)), WindowLayoutKind::Dwindle);
+        assert_eq!(
+            registry.kind_for_window(&4),
+            Some(WindowLayoutKind::Dwindle)
+        );
+        assert_eq!(registry.space_for(&2), Some(space(1)));
+
+        prepare(&mut registry, 1);
+        prepare(&mut registry, 2);
+        // 两个实例各自排列,互不串扰:scrolling 保持整高两列,dwindle 对半分宽。
+        let scrolling = registry.arrange(space(1), area(), 0);
+        assert_eq!(scrolling.len(), 2);
+        assert!(
+            scrolling
+                .iter()
+                .all(|placement| placement.geometry.size.h == 600)
+        );
+        let dwindle = registry.arrange(space(2), area(), 0);
+        assert_eq!(dwindle.len(), 2);
+        assert!(
+            dwindle
+                .iter()
+                .all(|placement| placement.geometry.size.w < 1000)
+        );
+    }
+
+    #[test]
+    fn registry_rejects_cross_kind_swap_and_move_beside() {
+        let mut registry = LayoutRegistry::<u64>::new(WindowLayoutKind::Scrolling);
+        registry.set_kinds(
+            WindowLayoutKind::Scrolling,
+            HashMap::from([(2, WindowLayoutKind::Dwindle)]),
+        );
+        for (window, workspace) in [(1, 1), (2, 2)] {
+            registry.insert(LayoutInsertion {
+                window,
+                space: space(workspace),
+                anchor: None,
+            });
+        }
+        assert!(!registry.swap(&1, &2));
+        assert!(!registry.move_beside(&1, &2, LayoutDirection::Right));
+        registry.insert(LayoutInsertion {
+            window: 3,
+            space: space(2),
+            anchor: Some(2),
+        });
+        assert!(registry.swap(&2, &3));
+    }
+
+    #[test]
+    fn registry_rebuild_groups_insertions_per_kind() {
+        let mut registry = LayoutRegistry::<u64>::new(WindowLayoutKind::Dwindle);
+        registry.set_kinds(
+            WindowLayoutKind::Dwindle,
+            HashMap::from([(2, WindowLayoutKind::Scrolling)]),
+        );
+        registry.rebuild(vec![
+            LayoutInsertion {
+                window: 1,
+                space: space(1),
+                anchor: None,
+            },
+            LayoutInsertion {
+                window: 2,
+                space: space(1),
+                anchor: Some(1),
+            },
+            LayoutInsertion {
+                window: 3,
+                space: space(2),
+                anchor: None,
+            },
+        ]);
+        assert_eq!(
+            registry.kind_for_window(&3),
+            Some(WindowLayoutKind::Scrolling)
+        );
+        assert_eq!(
+            registry.kind_for_window(&2),
+            Some(WindowLayoutKind::Dwindle)
+        );
+        assert_eq!(registry.space_for(&1), Some(space(1)));
+    }
+
+    #[test]
+    fn registry_manages_geometry_when_an_override_manages() {
+        let mut registry = LayoutRegistry::<u64>::new(WindowLayoutKind::Stacking);
+        assert!(!registry.manages_geometry());
+        registry.set_kinds(
+            WindowLayoutKind::Stacking,
+            HashMap::from([(2, WindowLayoutKind::Dwindle)]),
+        );
+        assert!(registry.manages_geometry());
+    }
+
+    #[test]
+    fn registry_snapshot_previews_without_touching_authoritative_state() {
+        let mut registry = LayoutRegistry::<u64>::new(WindowLayoutKind::Dwindle);
+        registry.insert(LayoutInsertion {
+            window: 1,
+            space: space(1),
+            anchor: None,
+        });
+        registry.insert(LayoutInsertion {
+            window: 2,
+            space: space(1),
+            anchor: Some(1),
+        });
+        let mut preview = registry.snapshot();
+        assert!(preview.swap(&1, &2));
+        // 预览换了,权威状态不动。
+        assert_eq!(registry.space_for(&1), Some(space(1)));
+        assert_eq!(registry.space_for(&2), Some(space(1)));
+    }
+}
+
+/// `WindowLayout` 要求实现者派生 Debug。
+#[derive(Debug)]
+pub(super) struct LayoutRegistry<WindowId> {
+    default_kind: WindowLayoutKind,
+    overrides: HashMap<u8, WindowLayoutKind>,
+    instances: HashMap<WindowLayoutKind, Instance<WindowId>>,
+}
+
+impl<WindowId> LayoutRegistry<WindowId>
+where
+    WindowId: Clone + Debug + Eq + 'static,
+{
+    pub(super) fn new(default_kind: WindowLayoutKind) -> Self {
+        let mut instances = HashMap::new();
+        instances.insert(default_kind, create_window_layout(default_kind));
+        Self {
+            default_kind,
+            overrides: HashMap::new(),
+            instances,
+        }
+    }
+
+    pub(super) fn default_kind(&self) -> WindowLayoutKind {
+        self.default_kind
+    }
+
+    pub(super) fn resolved_kind(&self, workspace: u8) -> WindowLayoutKind {
+        self.overrides
+            .get(&workspace)
+            .copied()
+            .unwrap_or(self.default_kind)
+    }
+
+    pub(super) fn kind_for_space(&self, space: LayoutSpace) -> WindowLayoutKind {
+        self.resolved_kind(space.workspace)
+    }
+
+    pub(super) fn kind_for_window(&self, window: &WindowId) -> Option<WindowLayoutKind> {
+        self.instances
+            .iter()
+            .find(|(_, instance)| instance.contains(window))
+            .map(|(kind, _)| *kind)
+    }
+
+    pub(super) fn kinds_match(
+        &self,
+        default_kind: WindowLayoutKind,
+        overrides: &HashMap<u8, WindowLayoutKind>,
+    ) -> bool {
+        self.default_kind == default_kind && self.overrides == *overrides
+    }
+
+    pub(super) fn override_count(&self) -> usize {
+        self.overrides.len()
+    }
+
+    pub(super) fn set_kinds(
+        &mut self,
+        default_kind: WindowLayoutKind,
+        overrides: HashMap<u8, WindowLayoutKind>,
+    ) {
+        self.default_kind = default_kind;
+        self.overrides = overrides;
+        self.instances
+            .entry(self.default_kind)
+            .or_insert_with(|| create_window_layout(self.default_kind));
+    }
+
+    fn instance_for_space(&self, workspace: u8) -> Option<&Instance<WindowId>> {
+        self.instances.get(&self.resolved_kind(workspace))
+    }
+
+    fn instance_for_space_mut(&mut self, workspace: u8) -> &mut Instance<WindowId> {
+        let kind = self.resolved_kind(workspace);
+        self.instances
+            .entry(kind)
+            .or_insert_with(|| create_window_layout(kind))
+    }
+
+    fn instance_for_window(&self, window: &WindowId) -> Option<&Instance<WindowId>> {
+        self.instances
+            .values()
+            .find(|instance| instance.contains(window))
+    }
+
+    fn instance_for_window_mut(&mut self, window: &WindowId) -> Option<&mut Instance<WindowId>> {
+        self.instances
+            .values_mut()
+            .find(|instance| instance.contains(window))
+    }
+
+    /// Cross-kind exchanges are meaningless (a dwindle leaf cannot join a
+    /// scrolling column), so both windows must belong to the same instance.
+    fn shared_instance_mut(
+        &mut self,
+        first: &WindowId,
+        second: &WindowId,
+    ) -> Option<&mut Instance<WindowId>> {
+        let kind = self.kind_for_window(first)?;
+        if self.kind_for_window(second) != Some(kind) {
+            warn!("refusing to exchange windows managed by different layout kinds");
+            return None;
+        }
+        self.instances.get_mut(&kind)
+    }
+}
+
+impl<WindowId> WindowLayout<WindowId> for LayoutRegistry<WindowId>
+where
+    WindowId: Clone + Debug + Eq + 'static,
+{
+    fn snapshot(&self) -> Box<dyn WindowLayout<WindowId>> {
+        Box::new(LayoutRegistrySnapshot {
+            default_kind: self.default_kind,
+            overrides: self.overrides.clone(),
+            instances: self
+                .instances
+                .iter()
+                .map(|(kind, instance)| (*kind, instance.snapshot()))
+                .collect(),
+        })
+    }
+
+    fn kind(&self) -> WindowLayoutKind {
+        self.default_kind
+    }
+
+    fn manages_geometry(&self) -> bool {
+        self.default_kind.manages_geometry()
+            || self.overrides.values().any(|kind| kind.manages_geometry())
+    }
+
+    fn insert(&mut self, insertion: LayoutInsertion<WindowId>) {
+        self.instance_for_space_mut(insertion.space.workspace)
+            .insert(insertion);
+    }
+
+    fn remove(&mut self, window: &WindowId) -> bool {
+        self.instance_for_window_mut(window)
+            .is_some_and(|instance| instance.remove(window))
+    }
+
+    fn contains(&self, window: &WindowId) -> bool {
+        self.instances
+            .values()
+            .any(|instance| instance.contains(window))
+    }
+
+    fn space_for(&self, window: &WindowId) -> Option<LayoutSpace> {
+        self.instance_for_window(window)
+            .and_then(|instance| instance.space_for(window))
+    }
+
+    fn clear(&mut self) {
+        for instance in self.instances.values_mut() {
+            instance.clear();
+        }
+    }
+
+    fn update_minimum_size(&mut self, window: &WindowId, minimum: Size<i32, Logical>) -> bool {
+        self.instance_for_window_mut(window)
+            .is_some_and(|instance| instance.update_minimum_size(window, minimum))
+    }
+
+    fn set_maximize_area(
+        &mut self,
+        space: LayoutSpace,
+        maximize_area: Rectangle<i32, Logical>,
+    ) {
+        self.instance_for_space_mut(space.workspace)
+            .set_maximize_area(space, maximize_area);
+    }
+
+    fn set_maximized(&mut self, window: &WindowId, maximized: bool) -> bool {
+        self.instance_for_window_mut(window)
+            .is_some_and(|instance| instance.set_maximized(window, maximized))
+    }
+
+    fn is_maximized(&self, window: &WindowId) -> bool {
+        self.instance_for_window(window)
+            .is_some_and(|instance| instance.is_maximized(window))
+    }
+
+    fn swap(&mut self, first: &WindowId, second: &WindowId) -> bool {
+        match self.shared_instance_mut(first, second) {
+            Some(instance) => instance.swap(first, second),
+            None => false,
+        }
+    }
+
+    fn move_beside(
+        &mut self,
+        window: &WindowId,
+        target: &WindowId,
+        direction: LayoutDirection,
+    ) -> bool {
+        match self.shared_instance_mut(window, target) {
+            Some(instance) => instance.move_beside(window, target, direction),
+            None => false,
+        }
+    }
+
+    fn move_beside_for_preview(
+        &mut self,
+        window: &WindowId,
+        target: &WindowId,
+        direction: LayoutDirection,
+        work_area: Rectangle<i32, Logical>,
+        gap: i32,
+        axis: LayoutAxis,
+    ) -> bool {
+        match self.shared_instance_mut(window, target) {
+            Some(instance) => {
+                instance.move_beside_for_preview(window, target, direction, work_area, gap, axis)
+            }
+            None => false,
+        }
+    }
+
+    fn resize(&mut self, request: LayoutResizeRequest<WindowId>) -> bool {
+        let window = request.window.clone();
+        match self.instance_for_window_mut(&window) {
+            Some(instance) => instance.resize(request),
+            None => false,
+        }
+    }
+
+    fn activate(&mut self, window: &WindowId) -> bool {
+        self.instance_for_window_mut(window)
+            .is_some_and(|instance| instance.activate(window))
+    }
+
+    fn rebuild(&mut self, insertions: Vec<LayoutInsertion<WindowId>>) {
+        let mut grouped: HashMap<WindowLayoutKind, Vec<LayoutInsertion<WindowId>>> = HashMap::new();
+        for insertion in insertions {
+            grouped
+                .entry(self.resolved_kind(insertion.space.workspace))
+                .or_default()
+                .push(insertion);
+        }
+        for (kind, group) in grouped {
+            self.instances
+                .entry(kind)
+                .or_insert_with(|| create_window_layout(kind))
+                .rebuild(group);
+        }
+    }
+
+    fn prepare_arrange(
+        &mut self,
+        space: LayoutSpace,
+        work_area: Rectangle<i32, Logical>,
+        gap: i32,
+        axis: LayoutAxis,
+    ) {
+        self.instance_for_space_mut(space.workspace)
+            .prepare_arrange(space, work_area, gap, axis);
+    }
+
+    fn scroll_horizontally(
+        &mut self,
+        space: LayoutSpace,
+        work_area: Rectangle<i32, Logical>,
+        gap: i32,
+        axis: LayoutAxis,
+        delta_x: f64,
+    ) -> bool {
+        self.instance_for_space_mut(space.workspace)
+            .scroll_horizontally(space, work_area, gap, axis, delta_x)
+    }
+
+    fn finish_horizontal_scroll(
+        &mut self,
+        space: LayoutSpace,
+        work_area: Rectangle<i32, Logical>,
+        gap: i32,
+        axis: LayoutAxis,
+        cancelled: bool,
+        projected_translation: Option<f64>,
+    ) -> Option<WindowId> {
+        self.instance_for_space_mut(space.workspace)
+            .finish_horizontal_scroll(
+                space,
+                work_area,
+                gap,
+                axis,
+                cancelled,
+                projected_translation,
+            )
+    }
+
+    fn arrange(
+        &self,
+        space: LayoutSpace,
+        work_area: Rectangle<i32, Logical>,
+        gap: i32,
+    ) -> Vec<LayoutPlacement<WindowId>> {
+        match self.instance_for_space(space.workspace) {
+            Some(instance) => instance.arrange(space, work_area, gap),
+            None => Vec::new(),
+        }
+    }
+}
+
+/// Frozen per-kind snapshots for drag previews. Dispatch mirrors
+/// `LayoutRegistry`; kinds the live registry never instantiated simply have no
+/// state here, matching the empty-space behavior of the authoritative path.
+#[derive(Debug)]
+struct LayoutRegistrySnapshot<WindowId> {
+    default_kind: WindowLayoutKind,
+    overrides: HashMap<u8, WindowLayoutKind>,
+    instances: HashMap<WindowLayoutKind, Instance<WindowId>>,
+}
+
+impl<WindowId> LayoutRegistrySnapshot<WindowId>
+where
+    WindowId: Clone + Debug + Eq + 'static,
+{
+    fn resolved_kind(&self, workspace: u8) -> WindowLayoutKind {
+        self.overrides
+            .get(&workspace)
+            .copied()
+            .unwrap_or(self.default_kind)
+    }
+
+    fn instance_for_space(&self, workspace: u8) -> Option<&Instance<WindowId>> {
+        self.instances.get(&self.resolved_kind(workspace))
+    }
+
+    fn instance_for_window(&self, window: &WindowId) -> Option<&Instance<WindowId>> {
+        self.instances
+            .values()
+            .find(|instance| instance.contains(window))
+    }
+}
+
+impl<WindowId> WindowLayout<WindowId> for LayoutRegistrySnapshot<WindowId>
+where
+    WindowId: Clone + Debug + Eq + 'static,
+{
+    fn snapshot(&self) -> Box<dyn WindowLayout<WindowId>> {
+        Box::new(LayoutRegistrySnapshot {
+            default_kind: self.default_kind,
+            overrides: self.overrides.clone(),
+            instances: self
+                .instances
+                .iter()
+                .map(|(kind, instance)| (*kind, instance.snapshot()))
+                .collect(),
+        })
+    }
+
+    fn kind(&self) -> WindowLayoutKind {
+        self.default_kind
+    }
+
+    fn manages_geometry(&self) -> bool {
+        self.default_kind.manages_geometry()
+            || self.overrides.values().any(|kind| kind.manages_geometry())
+    }
+
+    fn insert(&mut self, _insertion: LayoutInsertion<WindowId>) {}
+
+    fn remove(&mut self, _window: &WindowId) -> bool {
+        false
+    }
+
+    fn contains(&self, window: &WindowId) -> bool {
+        self.instances
+            .values()
+            .any(|instance| instance.contains(window))
+    }
+
+    fn space_for(&self, window: &WindowId) -> Option<LayoutSpace> {
+        self.instance_for_window(window)
+            .and_then(|instance| instance.space_for(window))
+    }
+
+    fn clear(&mut self) {}
+
+    fn update_minimum_size(&mut self, _window: &WindowId, _minimum: Size<i32, Logical>) -> bool {
+        false
+    }
+
+    fn set_maximize_area(
+        &mut self,
+        space: LayoutSpace,
+        maximize_area: Rectangle<i32, Logical>,
+    ) {
+        if let Some(instance) = self.instances.get_mut(&self.resolved_kind(space.workspace)) {
+            instance.set_maximize_area(space, maximize_area);
+        }
+    }
+
+    fn is_maximized(&self, window: &WindowId) -> bool {
+        self.instance_for_window(window)
+            .is_some_and(|instance| instance.is_maximized(window))
+    }
+
+    fn swap(&mut self, first: &WindowId, second: &WindowId) -> bool {
+        self.instances
+            .values_mut()
+            .find(|instance| instance.contains(first))
+            .filter(|instance| instance.contains(second))
+            .is_some_and(|instance| instance.swap(first, second))
+    }
+
+    fn move_beside(
+        &mut self,
+        window: &WindowId,
+        target: &WindowId,
+        direction: LayoutDirection,
+    ) -> bool {
+        self.instances
+            .values_mut()
+            .find(|instance| instance.contains(window) && instance.contains(target))
+            .is_some_and(|instance| instance.move_beside(window, target, direction))
+    }
+
+    fn move_beside_for_preview(
+        &mut self,
+        window: &WindowId,
+        target: &WindowId,
+        direction: LayoutDirection,
+        work_area: Rectangle<i32, Logical>,
+        gap: i32,
+        axis: LayoutAxis,
+    ) -> bool {
+        self.instances
+            .values_mut()
+            .find(|instance| instance.contains(window) && instance.contains(target))
+            .is_some_and(|instance| {
+                instance.move_beside_for_preview(window, target, direction, work_area, gap, axis)
+            })
+    }
+
+    fn resize(&mut self, _request: LayoutResizeRequest<WindowId>) -> bool {
+        false
+    }
+
+    fn activate(&mut self, window: &WindowId) -> bool {
+        self.instances
+            .values_mut()
+            .find(|instance| instance.contains(window))
+            .is_some_and(|instance| instance.activate(window))
+    }
+
+    fn rebuild(&mut self, _insertions: Vec<LayoutInsertion<WindowId>>) {}
+
+    fn prepare_arrange(
+        &mut self,
+        space: LayoutSpace,
+        work_area: Rectangle<i32, Logical>,
+        gap: i32,
+        axis: LayoutAxis,
+    ) {
+        if let Some(instance) = self.instances.get_mut(&self.resolved_kind(space.workspace)) {
+            instance.prepare_arrange(space, work_area, gap, axis);
+        }
+    }
+
+    fn scroll_horizontally(
+        &mut self,
+        _space: LayoutSpace,
+        _work_area: Rectangle<i32, Logical>,
+        _gap: i32,
+        _axis: LayoutAxis,
+        _delta_x: f64,
+    ) -> bool {
+        false
+    }
+
+    fn finish_horizontal_scroll(
+        &mut self,
+        _space: LayoutSpace,
+        _work_area: Rectangle<i32, Logical>,
+        _gap: i32,
+        _axis: LayoutAxis,
+        _cancelled: bool,
+        _projected_translation: Option<f64>,
+    ) -> Option<WindowId> {
+        None
+    }
+
+    fn arrange(
+        &self,
+        space: LayoutSpace,
+        work_area: Rectangle<i32, Logical>,
+        gap: i32,
+    ) -> Vec<LayoutPlacement<WindowId>> {
+        match self.instance_for_space(space.workspace) {
+            Some(instance) => instance.arrange(space, work_area, gap),
+            None => Vec::new(),
+        }
+    }
+}
