+/// Scales raw bytes-per-second history to 0-1 relative to the window peak so
+/// a throughput sparkline reads like the CPU/GPU ones; an all-zero window
+/// renders as a flat zero line.
+List<double> normalizeLoadHistory(List<double> history) {
+  var peak = 0.0;
+  for (final value in history) {
+    if (value > peak) {
+      peak = value;
+    }
+  }
+  if (peak <= 0) {
+    return List<double>.filled(history.length, 0.0, growable: false);
+  }
+  return <double>[
+    for (final value in history) (value / peak).clamp(0.0, 1.0).toDouble(),
+  ];
