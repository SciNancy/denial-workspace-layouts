new file mode 100644
index 0000000..ee90109
--- /dev/null
+++ b/dart_shell/lib/src/services/network_usage_service.dart
@@ -0,0 +1,135 @@
+import 'dart:io';
+
+import 'package:flutter/foundation.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+import 'package:path/path.dart' as p;
+
+final networkUsageServiceProvider = Provider<NetworkUsageService>((ref) {
+  return NetworkUsageService();
+});
+
+/// One pair of rx/tx counter readings on the default-route interface.
+@immutable
+class NetworkCounterSample {
+  const NetworkCounterSample({
+    required this.interface,
+    required this.rxBytes,
+    required this.txBytes,
+    required this.at,
+  });
+
+  final String interface;
+  final int rxBytes;
+  final int txBytes;
+  final Duration at;
+}
+
+/// Rates derived from two counter readings, in bytes per second.
+@immutable
+class NetworkRates {
+  const NetworkRates({required this.rxBps, required this.txBps});
+
+  final double rxBps;
+  final double txBps;
+}
+
+/// Rates between two counter samples, or null when no time elapsed or a
+/// counter moved backwards (interface swap, wrap, or rebuild).
+@visibleForTesting
+NetworkRates? ratesBetween(NetworkCounterSample previous, next) {
+  final dt = (next.at - previous.at).inMilliseconds / 1000.0;
+  final rxDelta = next.rxBytes - previous.rxBytes;
+  final txDelta = next.txBytes - previous.txBytes;
+  if (dt <= 0 || rxDelta < 0 || txDelta < 0) {
+    return null;
+  }
+  return NetworkRates(rxBps: rxDelta / dt, txBps: txDelta / dt);
+}
+
+/// Returns the interface name of the first default route in a
+/// `/proc/net/route` table, or null when the table has none or is malformed.
+@visibleForTesting
+String? parseDefaultRouteInterface(String content) {
+  final lines = content.split('\n');
+  if (lines.isEmpty || !lines.first.startsWith('Iface')) {
+    return null;
+  }
+  for (final line in lines.skip(1)) {
+    if (line.trim().isEmpty) {
+      continue;
+    }
+    final fields = line.split(RegExp(r'\s+'));
+    if (fields.length < 2) {
+      return null;
+    }
+    if (fields[1] == '00000000') {
+      return fields[0];
+    }
+  }
+  return null;
+}
+
+/// Measures throughput on whichever interface owns the default route. A TUN-
+/// style proxy hijacks the default route onto its own device; re-resolving
+/// the route every read follows that switch automatically, and the rate
+/// baseline resets so counters never mix across interfaces.
+class NetworkUsageService {
+  NetworkUsageService({
+    this.routePath = '/proc/net/route',
+    this.netRoot = '/sys/class/net',
+    Duration Function()? clock,
+  }) : _clock =
+           clock ??
+           (() =>
+               Duration(milliseconds: DateTime.now().millisecondsSinceEpoch));
+
+  final String routePath;
+  final String netRoot;
+  final Duration Function() _clock;
+  NetworkCounterSample? _previous;
+
+  /// Rates since the previous read, or null on the first read, after an
+  /// interface change, or whenever anything is unreadable.
+  Future<NetworkRates?> read() async {
+    String? interface;
+    try {
+      interface = parseDefaultRouteInterface(
+        await File(routePath).readAsString(),
+      );
+    } on FileSystemException {
+      return null;
+    }
+    if (interface == null) {
+      return null;
+    }
+    final int rx;
+    final int tx;
+    try {
+      final statsDir = p.join(netRoot, interface, 'statistics');
+      rx = int.parse(
+        (await File(p.join(statsDir, 'rx_bytes')).readAsString()).trim(),
+      );
+      tx = int.parse(
+        (await File(p.join(statsDir, 'tx_bytes')).readAsString()).trim(),
+      );
+    } on FileSystemException {
+      return null;
+    } on FormatException {
+      return null;
+    }
+    final sample = NetworkCounterSample(
+      interface: interface,
+      rxBytes: rx,
+      txBytes: tx,
+      at: _clock(),
+    );
+    final previous = _previous;
+    _previous = sample;
+    // Never blend counters from two interfaces (e.g. a proxy TUN taking
+    // over the default route): the swap itself yields no rate.
+    if (previous == null || previous.interface != interface) {
+      return null;
+    }
+    return ratesBetween(previous, sample);
+  }
+}
