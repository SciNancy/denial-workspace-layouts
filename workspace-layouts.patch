+  });
 }
diff --git a/dart_shell/test/state/system_status_test.dart b/dart_shell/test/state/system_status_test.dart
new file mode 100644
index 0000000..ebc3bf5
--- /dev/null
+++ b/dart_shell/test/state/system_status_test.dart
@@ -0,0 +1,51 @@
+import 'package:denial_dart_shell/src/state/system_status.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+void main() {
+  group('normalizeLoadHistory', () {
+    test('scales values relative to the window peak', () {
+      expect(normalizeLoadHistory(<double>[1.0e6, 3.2e6]), <double>[
+        0.3125,
+        1.0,
+      ]);
+    });
+
+    test('maps an all-zero window to a flat zero line', () {
+      expect(normalizeLoadHistory(<double>[0, 0, 0]), <double>[0, 0, 0]);
+    });
+
+    test('keeps a single sample at full height', () {
+      expect(normalizeLoadHistory(<double>[5.0]), <double>[1.0]);
+    });
+
+    test('returns an empty list for empty history', () {
+      expect(normalizeLoadHistory(const <double>[]), isEmpty);
+    });
+  });
+
+  group('formatNetworkRate', () {
+    test('formats sub-kilobyte rates as whole bytes', () {
+      expect(formatNetworkRate(0), '0B');
+      expect(formatNetworkRate(512), '512B');
+      expect(formatNetworkRate(999), '999B');
+    });
+
+    test('formats kilobyte rates with one decimal under 100', () {
+      expect(formatNetworkRate(12.34e3), '12.3K');
+      expect(formatNetworkRate(256e3), '256K');
+    });
+
+    test('formats megabyte and gigabyte rates', () {
+      expect(formatNetworkRate(3.2e6), '3.2M');
+      expect(formatNetworkRate(1.07e9), '1.1G');
+    });
+
+    test('never widens past four characters when rounding reaches 100', () {
+      // 99.95K would round to the five-character "100.0K", which is wider than
+      // the system bar reserves for one direction.
+      expect(formatNetworkRate(99.9e3), '99.9K');
+      expect(formatNetworkRate(99.95e3), '100K');
+      expect(formatNetworkRateParts(99.95e3).value.length, lessThanOrEqualTo(4));
+    });
+  });
+}
