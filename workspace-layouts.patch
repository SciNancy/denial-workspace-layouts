+
+Future<void> _settleWrites(WidgetTester tester) async {
+  // ShellSettingsController debounces writes by 180ms.
+  await tester.pump(const Duration(milliseconds: 250));
+  await tester.pump();
+  await tester.pump();
+}
+
+Widget _harness(_MemorySettingsTransport transport) {
+  return ProviderScope(
+    overrides: [
+      settingsStoreProvider.overrideWithValue(NativeSettingsStore(transport)),
+    ],
+    child: MaterialApp(
+      home: DenialLocalizationScope(
+        locale: const Locale('en'),
+        child: ShellTheme(
+          data: const ShellThemeData(),
+          child: const Material(
+            child: SingleChildScrollView(
+              child: SizedBox(
+                width: 430,
+                child: DesktopWorkspacesSection(),
+              ),
+            ),
+          ),
+        ),
+      ),
+    ),
+  );
+}
+
+class _MemorySettingsTransport
+    implements SettingsDocumentTransport, SettingsDocumentUpdateSource {
+  _MemorySettingsTransport([ShellSettings? initial])
+    : _settings = initial ?? const ShellSettings();
+
+  ShellSettings _settings;
+  int revision = 1;
+  final StreamController<DenialSettingsDocument> _updates =
+      StreamController<DenialSettingsDocument>.broadcast();
+
+  ShellSettings get settings => _settings;
+
+  String _document() => '${jsonEncode(_settings.toJson())}\n';
+
+  void _emit() {
+    _updates.add(DenialSettingsDocument(revision: revision, json: _document()));
+  }
+
+  @override
+  Stream<DenialSettingsDocument> get settingsDocumentUpdates async* {
+    yield DenialSettingsDocument(revision: revision, json: _document());
+    yield* _updates.stream;
+  }
+
+  @override
+  Future<DenialSettingsDocument> read() async =>
+      DenialSettingsDocument(revision: revision, json: _document());
+
+  @override
+  Future<DenialSettingsDocument> write({
+    required int expectedRevision,
+    required String document,
+  }) async {
+    if (expectedRevision != revision) {
+      throw StateError('settings revision conflict');
+    }
+    revision += 1;
+    _settings = ShellSettings.fromJson(
+      jsonDecode(document) as Map<String, dynamic>,
+    );
+    _emit();
+    return DenialSettingsDocument(revision: revision, json: _document());
+  }
+}
