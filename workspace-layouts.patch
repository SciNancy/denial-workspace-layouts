+MemAvailable:    8192000 kB
+''';
+
+      expect(parseMeminfoUsedFraction(content), isNull);
+    });
+  });
+
+  group('MemoryUsageService', () {
+    test('returns null when the meminfo file is unreadable', () async {
+      final service = MemoryUsageService(
+        meminfoPath: '/nonexistent/proc/meminfo',
+      );
+
+      expect(await service.read(), isNull);
+    });
+
+    test('reads the used fraction from an injected meminfo file', () async {
+      final temp = Directory.systemTemp.createTempSync('denial-memory-test');
+      addTearDown(() => temp.deleteSync(recursive: true));
+      final meminfo = File('${temp.path}/meminfo')
+        ..writeAsStringSync(
+          'MemTotal:       10000000 kB\nMemAvailable:    2500000 kB\n',
+        );
+
+      final service = MemoryUsageService(meminfoPath: meminfo.path);
+
+      expect(await service.read(), closeTo(0.75, 1e-9));
+    });
+  });
+}
diff --git a/dart_shell/test/services/network_usage_service_test.dart b/dart_shell/test/services/network_usage_service_test.dart
new file mode 100644
index 0000000..cd93518
--- /dev/null
+++ b/dart_shell/test/services/network_usage_service_test.dart
@@ -0,0 +1,159 @@
+import 'dart:io';
+
+import 'package:denial_dart_shell/src/services/network_usage_service.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+void main() {
+  group('parseDefaultRouteInterface', () {
+    test('returns the interface of the first default route', () {
+      const content = '''
+Iface	Destination	Gateway	Flags	RefCnt	Use	Metric	Mask		MTU	Window	IRTT
+wlan0	00000000	0102A8C0	0003	0	0	600	00000000	0	0	0
+wlan0	0000FEA9	00000000	0001	0	0	1000	0000FFFF	0	0	0
+eth0	00000000	0103A8C0	0003	0	0	700	00000000	0	0	0
+''';
+
+      expect(parseDefaultRouteInterface(content), 'wlan0');
+    });
+
+    test('returns null when no default route exists', () {
+      const content = '''
+Iface	Destination	Gateway	Flags	RefCnt	Use	Metric	Mask		MTU	Window	IRTT
+docker0	000011AC	00000000	0001	0	0	0	0000FFFF	0	0	0
+''';
+
+      expect(parseDefaultRouteInterface(content), isNull);
+    });
+
+    test('returns null for a malformed table', () {
+      expect(parseDefaultRouteInterface('not a route table'), isNull);
+    });
+  });
+
+  group('ratesBetween', () {
+    NetworkCounterSample counter(
+      int rx,
+      int tx, {
+      Duration at = Duration.zero,
+    }) => NetworkCounterSample(
+      interface: 'wlan0',
+      rxBytes: rx,
+      txBytes: tx,
+      at: at,
+    );
+
+    test('divides counter deltas by the elapsed time', () {
+      final rates = ratesBetween(
+        counter(1000, 2000),
+        counter(3000, 2500, at: const Duration(seconds: 2)),
+      );
+
+      expect(rates, isNotNull);
+      expect(rates!.rxBps, 1000.0);
+      expect(rates.txBps, 250.0);
+    });
+
+    test('returns null when no time elapsed', () {
+      expect(ratesBetween(counter(1000, 1000), counter(2000, 2000)), isNull);
+    });
+
+    test('returns null when counters moved backwards', () {
+      final rates = ratesBetween(
+        counter(3000, 3000),
+        counter(1000, 1000, at: const Duration(seconds: 2)),
+      );
+
+      expect(rates, isNull);
+    });
+  });
+
+  group('NetworkUsageService', () {
+    late Directory temp;
+    late File routeFile;
+    late Directory netRoot;
+
+    void writeInterface(String name, {required int rx, required int tx}) {
+      final stats = Directory('${netRoot.path}/$name/statistics')
+        ..createSync(recursive: true);
+      File('${stats.path}/rx_bytes').writeAsStringSync('$rx');
+      File('${stats.path}/tx_bytes').writeAsStringSync('$tx');
+    }
+
+    void writeRoute(String iface) {
+      routeFile.writeAsStringSync(
+        'Iface\tDestination\tGateway\tFlags\tRefCnt\tUse\tMetric\tMask\t\tMTU\tWindow\tIRTT\n'
+        '$iface\t00000000\t0102A8C0\t0003\t0\t0\t600\t00000000\t0\t0\t0\n',
+      );
+    }
+
+    setUp(() {
+      temp = Directory.systemTemp.createTempSync('denial-network-test');
+      addTearDown(() => temp.deleteSync(recursive: true));
+      _now = Duration.zero;
+      routeFile = File('${temp.path}/route')..writeAsStringSync('');
+      netRoot = Directory('${temp.path}/class/net')
+        ..createSync(recursive: true);
+    });
+
+    NetworkUsageService newService() => NetworkUsageService(
+      routePath: routeFile.path,
+      netRoot: netRoot.path,
+      clock: () => _now,
+    );
+
+    test('returns null until two samples exist', () async {
+      writeRoute('wlan0');
+      writeInterface('wlan0', rx: 1000, tx: 2000);
+      final service = newService();
+
+      expect(await service.read(), isNull);
+    });
+
+    test(
+      'computes rates from counter deltas on the default interface',
+      () async {
+        writeRoute('wlan0');
+        writeInterface('wlan0', rx: 1000, tx: 1000);
+        final service = newService();
+        await service.read();
+
+        _now = const Duration(seconds: 2);
+        writeInterface('wlan0', rx: 5000, tx: 2000);
+        final sample = await service.read();
+
+        expect(sample, isNotNull);
+        expect(sample!.rxBps, 2000.0);
+        expect(sample.txBps, 500.0);
+      },
+    );
+
+    test('resets when the default interface changes', () async {
+      writeRoute('wlan0');
+      writeInterface('wlan0', rx: 1000, tx: 1000);
+      final service = newService();
+      _now = const Duration(seconds: 2);
+      await service.read();
+
+      // A TUN-style proxy hijacks the default route onto its own device.
+      writeRoute('meta');
+      writeInterface('meta', rx: 5000, tx: 5000);
+      _now = const Duration(seconds: 4);
+      expect(await service.read(), isNull);
+
+      _now = const Duration(seconds: 6);
+      writeInterface('meta', rx: 9000, tx: 7000);
+      final sample = await service.read();
+      expect(sample, isNotNull);
+      expect(sample!.rxBps, 2000.0);
+      expect(sample.txBps, 1000.0);
+    });
+
+    test('returns null when no default route exists', () async {
+      final service = newService();
+
+      expect(await service.read(), isNull);
+    });
+  });
+}
+
+Duration _now = Duration.zero;
