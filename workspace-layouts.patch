--- a/compositor/src/bin/denialctl.rs
+++ b/compositor/src/bin/denialctl.rs
@@ -85,6 +85,9 @@ enum Command {
     },
     UiAutoReload(bool),
     UiVmService,
+    LayoutGet,
+    LayoutSet { kind: &'static str, workspace: u8 },
+    LayoutUnset { workspace: u8 },
 }
 
 impl Options {
@@ -184,6 +187,14 @@ fn parse_command(arguments: Vec<OsString>) -> Result<Command, CliError> {
             expected_mode: None,
         }),
         ["ui", "vm-service"] | ["ui", "uri"] => Ok(Command::UiVmService),
+        ["layout", "get"] => Ok(Command::LayoutGet),
+        ["layout", "set", kind, "--workspace", workspace] => Ok(Command::LayoutSet {
+            kind: parse_layout_kind(kind)?,
+            workspace: parse_workspace_number(workspace)?,
+        }),
+        ["layout", "unset", "--workspace", workspace] => Ok(Command::LayoutUnset {
+            workspace: parse_workspace_number(workspace)?,
+        }),
         _ => Err(CliError::usage(format!(
             "unknown command {}",
             words.join(" ")
@@ -201,6 +212,69 @@ fn parse_switch(value: &str) -> Result<bool, CliError> {
     }
 }
 
+fn parse_layout_kind(value: &str) -> Result<&'static str, CliError> {
+    match value {
+        "stacking" | "dwindle" | "scrolling" => Ok(match value {
+            "stacking" => "stacking",
+            "dwindle" => "dwindle",
+            _ => "scrolling",
+        }),
+        _ => Err(CliError::usage(format!(
+            "unknown layout {value:?} (expected stacking, dwindle, or scrolling)"
+        ))),
+    }
+}
+
+struct SettingsDocumentHandle {
+    revision: u64,
+    parsed: Value,
+}
+
+fn read_settings_document(client: &mut ControlClient) -> Result<SettingsDocumentHandle, CliError> {
+    let response = client.request("settings.document.get", Value::Null)?;
+    let revision = response.result["revision"]
+        .as_u64()
+        .ok_or_else(|| CliError::new("compositor returned no settings revision"))?;
+    let document = response.result["document"]
+        .as_str()
+        .ok_or_else(|| CliError::new("compositor returned no settings document"))?;
+    let parsed = serde_json::from_str(document)
+        .map_err(|error| CliError::new(format!("settings document is not valid JSON: {error}")))?;
+    Ok(SettingsDocumentHandle { revision, parsed })
+}
+
+fn workspace_count_limit(handle: &SettingsDocumentHandle) -> u64 {
+    handle.parsed["layout"]["workspaceCount"]
+        .as_u64()
+        .unwrap_or(1)
+        .max(1)
+}
+
+fn apply_settings_document(
+    client: &mut ControlClient,
+    handle: &SettingsDocumentHandle,
+) -> Result<(), CliError> {
+    let document = serde_json::to_string(&handle.parsed)
+        .map_err(|error| CliError::new(format!("could not re-encode settings document: {error}")))?;
+    client.request(
+        "settings.document.apply",
+        json!({"expected_revision": handle.revision, "document": document}),
+    )?;
+    Ok(())
+}
+
+fn parse_workspace_number(value: &str) -> Result<u8, CliError> {
+    let workspace = value.parse::<u8>().map_err(|_| {
+        CliError::usage(format!(
+            "workspace must be a number from 1 to 255, got {value:?}"
+        ))
+    })?;
+    if workspace == 0 {
+        return Err(CliError::usage("workspace numbers start at 1"));
+    }
+    Ok(workspace)
+}
+
 fn execute(client: &mut ControlClient, options: &Options) -> Result<(), CliError> {
     match &options.command {
         Command::Help | Command::Version => unreachable!("handled before socket discovery"),
@@ -294,6 +368,67 @@ fn execute(client: &mut ControlClient, options: &Options) -> Result<(), CliError
                 println!("{}", state.vm_service_uri);
             }
         }
+        Command::LayoutGet => {
+            let handle = read_settings_document(client)?;
+            let layout = &handle.parsed["layout"];
+            let overrides = layout["workspaceLayouts"]
+                .as_object()
+                .cloned()
+                .unwrap_or_default();
+            if options.json {
+                print_json(&json!({
+                    "default": layout["windowLayout"],
+                    "workspaces": overrides,
+                }))?;
+            } else {
+                println!(
+                    "default layout: {}",
+                    layout["windowLayout"].as_str().unwrap_or("?")
+                );
+                if overrides.is_empty() {
+                    println!("workspace overrides: none");
+                } else {
+                    let mut entries = overrides.iter().collect::<Vec<_>>();
+                    entries.sort_by_key(|(workspace, _)| {
+                        workspace.parse::<u8>().unwrap_or(u8::MAX)
+                    });
+                    for (workspace, kind) in entries {
+                        println!("workspace {workspace}: {}", kind.as_str().unwrap_or("?"));
+                    }
+                }
+            }
+        }
+        Command::LayoutSet { kind, workspace } => {
+            let mut handle = read_settings_document(client)?;
+            if u64::from(*workspace) > workspace_count_limit(&handle) {
+                return Err(CliError::new(format!(
+                    "workspace {workspace} exceeds the configured workspace count"
+                )));
+            }
+            let layout = handle.parsed["layout"]
+                .as_object_mut()
+                .ok_or_else(|| CliError::new("settings document has no layout section"))?;
+            let overrides = layout
+                .entry("workspaceLayouts".to_owned())
+                .or_insert_with(|| json!({}))
+                .as_object_mut()
+                .ok_or_else(|| CliError::new("layout.workspaceLayouts is not an object"))?;
+            overrides.insert(workspace.to_string(), Value::String(kind.to_string()));
+            apply_settings_document(client, &handle)?;
+            println!("workspace {workspace} now uses the {kind} layout");
+        }
+        Command::LayoutUnset { workspace } => {
+            let mut handle = read_settings_document(client)?;
+            let removed = handle.parsed["layout"]["workspaceLayouts"]
+                .as_object_mut()
+                .is_some_and(|overrides| overrides.remove(&workspace.to_string()).is_some());
+            if removed {
+                apply_settings_document(client, &handle)?;
+                println!("workspace {workspace} now follows the default layout");
+            } else {
+                println!("workspace {workspace} already follows the default layout");
+            }
+        }
     }
     Ok(())
 }
