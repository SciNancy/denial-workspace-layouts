diff --git a/dart_shell/lib/src/desktop/desktop_dashboard_workspaces.dart b/dart_shell/lib/src/desktop/desktop_dashboard_workspaces.dart
new file mode 100644
index 0000000..1eab503
--- /dev/null
+++ b/dart_shell/lib/src/desktop/desktop_dashboard_workspaces.dart
@@ -0,0 +1,275 @@
+part of 'desktop_shell.dart';
+
+class DesktopWorkspacesSection extends ConsumerStatefulWidget {
+  const DesktopWorkspacesSection({super.key});
+
+  @override
+  ConsumerState<DesktopWorkspacesSection> createState() =>
+      _DesktopWorkspacesSectionState();
+}
+
+class _DesktopWorkspacesSectionState
+    extends ConsumerState<DesktopWorkspacesSection> {
+  int? _selectedWorkspace;
+  bool _justDecreased = false;
+
+  void _decrease() {
+    final layout = ref.read(shellSettingsProvider).layout;
+    final controller = ref.read(shellSettingsProvider.notifier);
+    if (!layout.workspacesEnabled) {
+      return;
+    }
+    setState(() => _justDecreased = true);
+    if (layout.workspaceCount <= minimumWorkspaceCount) {
+      controller.setWorkspacesEnabled(false);
+    } else {
+      controller.setWorkspaceCount((layout.workspaceCount - 1).toDouble());
+    }
+  }
+
+  void _increase() {
+    final layout = ref.read(shellSettingsProvider).layout;
+    final controller = ref.read(shellSettingsProvider.notifier);
+    setState(() => _justDecreased = false);
+    if (!layout.workspacesEnabled) {
+      controller.setWorkspacesEnabled(true);
+    } else if (layout.workspaceCount < maximumWorkspaceCount) {
+      controller.setWorkspaceCount((layout.workspaceCount + 1).toDouble());
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final settings = ref.watch(shellSettingsProvider);
+    final controller = ref.read(shellSettingsProvider.notifier);
+    final layout = settings.layout;
+    final enabled = layout.workspacesEnabled;
+    final count = enabled ? layout.workspaceCount : 1;
+    final activeValues = ref
+        .watch(desktopWorkspaceProvider)
+        .activeWorkspaces
+        .values;
+    final activeWorkspace = activeValues.isEmpty ? 1 : activeValues.first;
+    final selected =
+        (_selectedWorkspace ?? activeWorkspace).clamp(1, count).toInt();
+    final l10n = context.l10n;
+    final accent = ShellTheme.of(context).accent;
+
+    return Padding(
+      padding: const EdgeInsets.only(bottom: 12),
+      child: _DashboardCard(
+        child: Column(
+          crossAxisAlignment: CrossAxisAlignment.start,
+          children: [
+            Row(
+              children: [
+                Icon(Icons.space_dashboard_outlined, size: 21, color: accent),
+                const SizedBox(width: 10),
+                Expanded(
+                  child: Text(
+                    l10n.desktopWorkspacesCardTitle,
+                    style: context.shellTheme.text.cardTitle,
+                  ),
+                ),
+                _DashboardIconButton(
+                  semanticLabel: l10n.desktopWorkspaceDecrease,
+                  icon: Icons.remove_rounded,
+                  enabled: enabled,
+                  onTap: _decrease,
+                ),
+                const SizedBox(width: 7),
+                SizedBox(
+                  width: 28,
+                  child: Text(
+                    '$count',
+                    key: const ValueKey<String>('workspace-count'),
+                    textAlign: TextAlign.center,
+                    style: context.shellTheme.text.cardTitle,
+                  ),
+                ),
+                const SizedBox(width: 7),
+                _DashboardIconButton(
+                  semanticLabel: l10n.desktopWorkspaceIncrease,
+                  icon: Icons.add_rounded,
+                  enabled: !enabled || count < maximumWorkspaceCount,
+                  onTap: _increase,
+                ),
+              ],
+            ),
+            const SizedBox(height: 11),
+            if (_justDecreased) ...[
+              const SizedBox(height: 6),
+              Text(
+                l10n.desktopWorkspaceMergeNotice,
+                maxLines: 2,
+                overflow: TextOverflow.ellipsis,
+                style: context.shellTheme.text.cardTitle.copyWith(
+                  color: context.shellColors.textSecondary,
+                  fontSize: 11,
+                ),
+              ),
+            ],
+            const SizedBox(height: 10),
+            _DashboardSettingsRow(
+              label: l10n.desktopDefaultLayoutLabel,
+              child: SettingsSegmentedControl<DesktopWindowLayout>(
+                value: layout.windowLayout,
+                choices: [
+                  SettingsChoice(
+                    DesktopWindowLayout.stacking,
+                    l10n.settingsWindowLayoutStacking,
+                  ),
+                  SettingsChoice(
+                    DesktopWindowLayout.dwindle,
+                    l10n.settingsWindowLayoutDwindle,
+                  ),
+                  SettingsChoice(
+                    DesktopWindowLayout.scrolling,
+                    l10n.settingsWindowLayoutScrolling,
+                  ),
+                ],
+                onChanged: controller.setDesktopWindowLayout,
+              ),
+            ),
+            const SizedBox(height: 10),
+            if (!enabled)
+              Text(
+                l10n.desktopWorkspacesDisabledNotice,
+                maxLines: 2,
+                overflow: TextOverflow.ellipsis,
+                style: context.shellTheme.text.cardTitle.copyWith(
+                  color: context.shellColors.textSecondary,
+                  fontSize: 11,
+                ),
+              )
+            else ...[
+              Wrap(
+                spacing: 6,
+                runSpacing: 6,
+                children: [
+                  for (var index = 1; index <= count; index += 1)
+                    _WorkspaceChip(
+                      key: ValueKey<String>('workspace-chip-$index'),
+                      label: '$index',
+                      selected: index == selected,
+                      onTap: () =>
+                          setState(() => _selectedWorkspace = index),
+                    ),
+                ],
+              ),
+              const SizedBox(height: 8),
+              Text(
+                l10n.desktopWorkspaceLayoutLabel(selected),
+                maxLines: 1,
+                overflow: TextOverflow.ellipsis,
+                style: context.shellTheme.text.cardTitle.copyWith(
+                  color: context.shellColors.textSecondary,
+                  fontSize: 12,
+                ),
+              ),
+              const SizedBox(height: 6),
+              SettingsSegmentedControl<DesktopWindowLayout?>(
+                value: layout.workspaceLayouts[selected.toString()],
+                choices: [
+                  SettingsChoice(
+                    null,
+                    l10n.desktopWorkspaceLayoutFollowDefault,
+                  ),
+                  SettingsChoice(
+                    DesktopWindowLayout.stacking,
+                    l10n.settingsWindowLayoutStacking,
+                  ),
+                  SettingsChoice(
+                    DesktopWindowLayout.dwindle,
+                    l10n.settingsWindowLayoutDwindle,
+                  ),
+                  SettingsChoice(
+                    DesktopWindowLayout.scrolling,
+                    l10n.settingsWindowLayoutScrolling,
+                  ),
+                ],
+                onChanged: (kind) =>
+                    controller.setWorkspaceLayoutOverride(selected, kind),
+              ),
+            ],
+          ],
+        ),
+      ),
+    );
+  }
+}
+
+class _WorkspaceChip extends StatelessWidget {
+  const _WorkspaceChip({
+    required this.label,
+    required this.selected,
+    required this.onTap,
+    super.key,
+  });
+
+  final String label;
+  final bool selected;
+  final VoidCallback onTap;
+
+  @override
+  Widget build(BuildContext context) {
+    final accent = ShellTheme.of(context).accentPalette;
+    return Semantics(
+      button: true,
+      selected: selected,
+      label: label,
