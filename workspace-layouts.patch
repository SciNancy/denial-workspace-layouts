+
+/// Compact throughput label: bytes below 1K, otherwise one decimal while the
+/// value stays under 100 and whole units above (`3.2M`, `256K`, `512B`).
+String formatNetworkRate(double bytesPerSecond) {
+  final parts = formatNetworkRateParts(bytesPerSecond);
+  return '${parts.value}${parts.unit}';
+}
+
+/// [formatNetworkRate] split into number and unit, so the system bar can tint
+/// the unit like the other captions instead of giving it value weight.
+({String value, String unit}) formatNetworkRateParts(double bytesPerSecond) {
+  const units = <String>['B', 'K', 'M', 'G'];
+  var value = bytesPerSecond;
+  var unit = 0;
+  while (value >= 1000 && unit < units.length - 1) {
+    value /= 1000;
+    unit += 1;
+  }
+  final rounded = value.roundToDouble();
+  if (value >= 100 || value == rounded) {
+    return (value: value.round().toString(), unit: units[unit]);
+  }
+  // Keep one decimal, but never let rounding widen the label to the
+  // five-character "100.0": the system bar sizes the value column for four
+  // digits, so 99.95K has to collapse to "100K" like every other 100+ reading.
+  final tenths = (value * 10).roundToDouble() / 10;
+  return (
+    value: tenths >= 100 ? tenths.round().toString() : tenths.toStringAsFixed(1),
+    unit: units[unit],
+  );
+}
