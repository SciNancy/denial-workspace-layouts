+struct SettingsDocumentHandle {
+    revision: u64,
+    parsed: Value,
+}
+
+fn read_settings_document(client: &mut ControlClient) -> Result<SettingsDocumentHandle, CliError> {
+    let response = client.request("settings.document.get", Value::Null)?;
+    let revision = response.result["revision"]
+        .as_u64()
+        .ok_or_else(|| CliError::new("compositor returned no settings revision"))?;
+    let document = response.result["document"]
+        .as_str()
+        .ok_or_else(|| CliError::new("compositor returned no settings document"))?;
+    let parsed = serde_json::from_str(document)
+        .map_err(|error| CliError::new(format!("settings document is not valid JSON: {error}")))?;
+    Ok(SettingsDocumentHandle { revision, parsed })
+}
+
+fn workspace_count_limit(handle: &SettingsDocumentHandle) -> u64 {
+    handle.parsed["layout"]["workspaceCount"]
+        .as_u64()
+        .unwrap_or(1)
+        .max(1)
+}
+
+fn apply_settings_document(
+    client: &mut ControlClient,
+    handle: &SettingsDocumentHandle,
+) -> Result<(), CliError> {
+    let document = serde_json::to_string(&handle.parsed).map_err(|error| {
+        CliError::new(format!("could not re-encode settings document: {error}"))
+    })?;
+    client.request(
+        "settings.document.apply",
+        json!({"expected_revision": handle.revision, "document": document}),
+    )?;
+    Ok(())
+}
+
+fn parse_workspace_number(value: &str) -> Result<u8, CliError> {
+    let workspace = value.parse::<u8>().map_err(|_| {
+        CliError::usage(format!(
+            "workspace must be a number from 1 to 255, got {value:?}"
+        ))
+    })?;
+    if workspace == 0 {
+        return Err(CliError::usage("workspace numbers start at 1"));
+    }
+    Ok(workspace)
+}
