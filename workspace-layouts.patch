 compositor/src/bin/deniald/settings/tests.rs | 47 ++++++++++++++++++++
 2 files changed, 92 insertions(+), 1 deletion(-)

diff --git a/compositor/src/bin/deniald/settings.rs b/compositor/src/bin/deniald/settings.rs
index 19b99c6..a8790b0 100644
--- a/compositor/src/bin/deniald/settings.rs
+++ b/compositor/src/bin/deniald/settings.rs
@@ -4,7 +4,7 @@
 //! file.  Every mutation is revision checked and committed by deniald through
 //! an fsync/rename transaction so compositor and shell settings cannot race.
 
-use std::collections::BTreeMap;
+use std::collections::{BTreeMap, HashMap};
 use std::error::Error;
 use std::fmt;
 use std::fs::{self, File, OpenOptions};
@@ -675,6 +675,10 @@ impl SettingsManager {
         parse_window_layout_kind(&self.document).unwrap_or_default()
     }
 
+    pub(super) fn workspace_layout_overrides(&self) -> HashMap<u8, WindowLayoutKind> {
+        parse_workspace_layout_overrides(&self.document)
+    }
+
     pub(super) fn workspace_settings(&self) -> WorkspaceSettings {
         parse_workspace_settings(&self.document).unwrap_or_default()
     }
@@ -1342,6 +1346,46 @@ fn set_window_layout_kind(
     Ok(())
 }
 
+fn parse_workspace_layout_overrides(
+    document: &Map<String, Value>,
+) -> HashMap<u8, WindowLayoutKind> {
+    let mut overrides = HashMap::new();
+    let Some(entries) = document
+        .get("layout")
+        .and_then(Value::as_object)
+        .and_then(|layout| layout.get("workspaceLayouts"))
+    else {
+        return overrides;
+    };
+    let Some(entries) = entries.as_object() else {
+        warn!("ignoring layout.workspaceLayouts: expected an object");
+        return overrides;
+    };
+    for (key, value) in entries {
+        let Ok(workspace) = key.parse::<u8>() else {
+            warn!(workspace = key, "ignoring workspace layout override with a non-numeric workspace");
+            continue;
+        };
+        if workspace == 0 {
+            warn!("ignoring workspace layout override for workspace 0");
+            continue;
+        }
+        let Some(name) = value.as_str() else {
+            warn!(workspace, "ignoring workspace layout override with a non-string layout");
+            continue;
+        };
+        match WindowLayoutKind::from_settings_name(name) {
+            Some(kind) => {
+                overrides.insert(workspace, kind);
+            }
+            None => {
+                warn!(workspace, layout = name, "ignoring workspace layout override with an unknown layout");
+            }
+        }
+    }
+    overrides
+}
+
 fn parse_workspace_settings(
     document: &Map<String, Value>,
 ) -> Result<WorkspaceSettings, SettingsError> {
diff --git a/compositor/src/bin/deniald/settings/tests.rs b/compositor/src/bin/deniald/settings/tests.rs
index 0653a2c..435c385 100644
--- a/compositor/src/bin/deniald/settings/tests.rs
+++ b/compositor/src/bin/deniald/settings/tests.rs
@@ -265,6 +265,53 @@ fn window_layout_is_validated_and_persisted() {
     }
 }
 
+#[test]
+fn workspace_layout_overrides_are_tolerant_per_entry() {
+    let temporary = TemporaryDirectory::new("settings-workspace-layouts");
+    let path = temporary.settings_path();
+    let mut manager = SettingsManager::load_path(path).unwrap();
+
+    let update = manager
+        .prepare_shell_update(
+            manager.revision(),
+            &shell_document(serde_json::json!({
+                "appearance": {"colorSchemePreference": "preferDark"},
+                "layout": {
+                    "windowLayout": "stacking",
+                    "workspaceLayouts": {
+                        "2": "dwindle",
+                        "3": "scrolling",
+                        "bad": "dwindle",
+                        "4": "bogus",
+                        "0": "dwindle"
+                    }
+                }
+            })),
+        )
+        .unwrap();
+    manager.commit(update).unwrap();
+    assert_eq!(
+        manager.workspace_layout_overrides(),
+        HashMap::from([(2, WindowLayoutKind::Dwindle), (3, WindowLayoutKind::Scrolling)])
+    );
+
+    let update = manager
+        .prepare_shell_update(
+            manager.revision(),
+            &shell_document(serde_json::json!({
+                "appearance": {"colorSchemePreference": "preferDark"},
+                "layout": {"workspaceLayouts": "dwindle"}
+            })),
+        )
+        .unwrap();
+    manager.commit(update).unwrap();
+    assert!(manager.workspace_layout_overrides().is_empty());
+
+    let fresh = TemporaryDirectory::new("settings-workspace-layouts-fresh");
+    let fresh_manager = SettingsManager::load_path(fresh.settings_path()).unwrap();
+    assert!(fresh_manager.workspace_layout_overrides().is_empty());
+}
+
