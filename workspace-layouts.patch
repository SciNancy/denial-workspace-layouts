 create mode 100644 dart_shell/test/desktop/desktop_dashboard_workspaces_test.dart

diff --git a/dart_shell/test/desktop/desktop_dashboard_workspaces_test.dart b/dart_shell/test/desktop/desktop_dashboard_workspaces_test.dart
new file mode 100644
index 0000000..397a879
--- /dev/null
+++ b/dart_shell/test/desktop/desktop_dashboard_workspaces_test.dart
@@ -0,0 +1,214 @@
+import 'dart:async';
+import 'dart:convert';
+
+import 'package:denial_dart_shell/src/desktop/desktop_shell.dart';
+import 'package:denial_dart_shell/src/localization/denial_localizations.dart';
+import 'package:denial_dart_shell/src/platform/denial_bridge.dart';
+import 'package:denial_dart_shell/src/settings/settings_controller.dart';
+import 'package:denial_dart_shell/src/settings/settings_store.dart';
+import 'package:denial_dart_shell/src/settings/shell_settings.dart';
+import 'package:denial_dart_shell/src/theme/shell_theme.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+void main() {
+  testWidgets('shows one workspace and the disabled notice when workspaces are off', (
+    tester,
+  ) async {
+    final transport = _MemorySettingsTransport();
+    await tester.pumpWidget(_harness(transport));
+    await tester.pump();
+
+    expect(find.text('Workspaces'), findsOneWidget);
+    expect(find.byKey(const ValueKey<String>('workspace-count')), findsOneWidget);
+    expect(
+      (tester.widget(find.byKey(const ValueKey<String>('workspace-count')))
+              as Text)
+          .data,
+      '1',
+    );
+    expect(find.textContaining('Workspaces are off'), findsOneWidget);
+  });
+
+  testWidgets('increase enables workspaces with the stored count', (
+    tester,
+  ) async {
+    final transport = _MemorySettingsTransport();
+    await tester.pumpWidget(_harness(transport));
+    await tester.pump();
+
+    await tester.tap(find.byIcon(Icons.add_rounded));
+    await _settleWrites(tester);
+
+    expect(transport.settings.layout.workspacesEnabled, isTrue);
+    expect(transport.settings.layout.workspaceCount, defaultWorkspaceCount);
+  });
+
+  testWidgets('decrease at the minimum count disables workspaces', (
+    tester,
+  ) async {
+    final transport = _MemorySettingsTransport(
+      const ShellSettings(
+        layout: ShellLayoutSettings(
+          workspacesEnabled: true,
+          workspaceCount: minimumWorkspaceCount,
+        ),
+      ),
+    );
+    await tester.pumpWidget(_harness(transport));
+    await tester.pump();
+
+    await tester.tap(find.byIcon(Icons.remove_rounded));
+    await _settleWrites(tester);
+
+    expect(transport.settings.layout.workspacesEnabled, isFalse);
+  });
+
+  testWidgets('decrease shows the merge notice', (tester) async {
+    final transport = _MemorySettingsTransport(
+      const ShellSettings(
+        layout: ShellLayoutSettings(
+          workspacesEnabled: true,
+          workspaceCount: 4,
+        ),
+      ),
+    );
+    await tester.pumpWidget(_harness(transport));
+    await tester.pump();
+
+    await tester.tap(find.byIcon(Icons.remove_rounded));
+    await tester.pump();
+
+    expect(
+      find.text(
+        'Windows on removed workspaces move to the highest remaining workspace.',
+      ),
+      findsOneWidget,
+    );
+    expect(transport.settings.layout.workspaceCount, 3);
+  });
+
+  testWidgets('selecting a workspace and a layout writes an override', (
+    tester,
+  ) async {
+    final transport = _MemorySettingsTransport(
+      const ShellSettings(
+        layout: ShellLayoutSettings(
+          workspacesEnabled: true,
+          workspaceCount: 3,
+        ),
+      ),
+    );
+    await tester.pumpWidget(_harness(transport));
+    await tester.pump();
+
+    await tester.tap(find.byKey(const ValueKey<String>('workspace-chip-3')));
+    await tester.pump();
+    await tester.tap(find.text('Tiling'));
+    await _settleWrites(tester);
+
+    expect(transport.settings.layout.workspaceLayouts, <String, DesktopWindowLayout>{
+      '3': DesktopWindowLayout.dwindle,
+    });
+  });
+
+  testWidgets('follow default removes the override', (tester) async {
+    final transport = _MemorySettingsTransport(
+      const ShellSettings(
+        layout: ShellLayoutSettings(
+          workspacesEnabled: true,
+          workspaceCount: 3,
+          workspaceLayouts: <String, DesktopWindowLayout>{
+            '2': DesktopWindowLayout.scrolling,
+          },
+        ),
+      ),
+    );
+    await tester.pumpWidget(_harness(transport));
+    await tester.pump();
+
+    await tester.tap(find.byKey(const ValueKey<String>('workspace-chip-2')));
+    await tester.pump();
+    await tester.tap(find.text('Follow default'));
+    await _settleWrites(tester);
+
+    expect(transport.settings.layout.workspaceLayouts, isEmpty);
+  });
+}
+
+Future<void> _settleWrites(WidgetTester tester) async {
+  // ShellSettingsController debounces writes by 180ms.
+  await tester.pump(const Duration(milliseconds: 250));
+  await tester.pump();
+  await tester.pump();
+}
+
+Widget _harness(_MemorySettingsTransport transport) {
+  return ProviderScope(
+    overrides: [
+      settingsStoreProvider.overrideWithValue(NativeSettingsStore(transport)),
+    ],
+    child: MaterialApp(
+      home: DenialLocalizationScope(
+        locale: const Locale('en'),
+        child: ShellTheme(
+          data: const ShellThemeData(),
+          child: const Material(
+            child: SingleChildScrollView(
+              child: SizedBox(
+                width: 430,
+                child: DesktopWorkspacesSection(),
+              ),
+            ),
+          ),
+        ),
+      ),
+    ),
+  );
+}
+
+class _MemorySettingsTransport
+    implements SettingsDocumentTransport, SettingsDocumentUpdateSource {
+  _MemorySettingsTransport([ShellSettings? initial])
+    : _settings = initial ?? const ShellSettings();
+
+  ShellSettings _settings;
+  int revision = 1;
+  final StreamController<DenialSettingsDocument> _updates =
+      StreamController<DenialSettingsDocument>.broadcast();
+
+  ShellSettings get settings => _settings;
+
+  String _document() => '${jsonEncode(_settings.toJson())}\n';
+
+  void _emit() {
+    _updates.add(DenialSettingsDocument(revision: revision, json: _document()));
+  }
+
+  @override
+  Stream<DenialSettingsDocument> get settingsDocumentUpdates async* {
+    yield DenialSettingsDocument(revision: revision, json: _document());
+    yield* _updates.stream;
+  }
+
+  @override
+  Future<DenialSettingsDocument> read() async =>
+      DenialSettingsDocument(revision: revision, json: _document());
+
+  @override
+  Future<DenialSettingsDocument> write({
+    required int expectedRevision,
+    required String document,
+  }) async {
+    if (expectedRevision != revision) {
+      throw StateError('settings revision conflict');
+    }
+    revision += 1;
+    _settings = ShellSettings.fromJson(
+      jsonDecode(document) as Map<String, dynamic>,
+    );
+    _emit();
+    return DenialSettingsDocument(revision: revision, json: _document());
+  }
+}
